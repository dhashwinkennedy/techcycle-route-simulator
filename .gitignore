# ==============================================================================
# Root .gitignore — E-Waste Route Optimisation Simulator (TechCycle)
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
# Ignore all local environment files and secret-bearing configs
.env
.env.*
*.env
local.env
dev.env
prod.env

# Protect subfolder environments
frontend/.env
frontend/.env.*
frontend/**/.env
frontend/**/.env.*
backend/.env
backend/.env.*

# Always keep example templates tracked and shareable
!*.env.example
!.env.example
!frontend/.env.example
!frontend/**/.env.example
!backend/.env.example

# ------------------------------------------------------------------------------
# Python & Backend Artifacts
# ------------------------------------------------------------------------------
# Bytecode and runtime caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, static analysis, and code coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Python packaging, builds, and distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# SQLite databases, write-ahead logs, and lock files
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Local database backups and snapshots
backups/
backend/backups/

# ------------------------------------------------------------------------------
# Frontend Artifacts (Node.js / React / Vite / TypeScript)
# ------------------------------------------------------------------------------
# Dependency directory
node_modules/
frontend/node_modules/
frontend/**/node_modules/

# Production build outputs
dist/
frontend/dist/
frontend/**/dist/
out/
build/

# Vite and TypeScript build caches
.vite/
frontend/.vite/
frontend/**/.vite/
*.tsbuildinfo
frontend/**/*.tsbuildinfo

# Linter caches
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Runtime Logs & Temporary Output
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Operating Systems & IDEs
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini

# Editors & IDEs
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
