# ==============================================================================
# TechCycle Frontend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development server:
#   Copy-Item .env.example .env   (PowerShell)
#   cp .env.example .env          (Bash)
#
# IMPORTANT SECURITY NOTE:
# Variables prefixed with VITE_ are inlined into client-side JavaScript bundles
# by Vite and are visible in browser DevTools. NEVER place private credentials,
# server-side keys, or database connection strings in this file.
# ==============================================================================

# FastAPI Backend Service URL
# The base URL where the FastAPI backend server is accessible.
VITE_API_BASE_URL=http://localhost:8000

# Geoapify Map Tiles Key (Browser-Safe Client Key)
# Optional: Used to load high-resolution Geoapify raster map tiles in Leaflet.
# If left blank, the frontend automatically falls back to OpenStreetMap tiles.
# DO NOT put your server-side GEOAPIFY_KEY here.
VITE_GEOAPIFY_MAP_KEY=
